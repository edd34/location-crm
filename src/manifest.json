{
  "manifest_version": 3,
  "name": "Notion Rent Tracker",
  "version": "1.0",
  "description": "Add rent information directly to Notion from any tab.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://api.notion.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "notion-rent-tracker@example.com"
    }
  }
}
