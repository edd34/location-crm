{
  "manifest_version": 3,
  "name": "Notion Rent Tracker",
  "version": "1.0",
  "description": "Add rent information directly to Notion from any tab.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://api.notion.com/*",
    "https://openrouter.ai/*",
    "https://maps.googleapis.com/*",
    "https://overpass-api.de/*",
    "https://data.geopf.fr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "notion-rent-tracker@example.com",
      "strict_min_version": "109.0"
    }
  }
}
